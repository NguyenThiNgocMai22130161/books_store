# ==========================================
# SPRING BOOT CONFIGURATION TEMPLATE
# Copy file này thành application.properties và điền các thông tin của bạn
# ==========================================

spring.application.name=books_store

# PostgreSQL Configuration (Thay bằng Database của bạn)
spring.datasource.url=jdbc:postgresql://localhost:5432/books_store
spring.datasource.username=postgres
spring.datasource.password=your_db_password
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Google OAuth2 (Nhận từ Google Cloud Console)
spring.security.oauth2.client.registration.google.client-id=YOUR_GOOGLE_CLIENT_ID
spring.security.oauth2.client.registration.google.client-secret=YOUR_GOOGLE_CLIENT_SECRET
spring.security.oauth2.client.registration.google.scope=profile,email
spring.security.oauth2.client.registration.google.redirect-uri=http://localhost:8080/login/oauth2/code/google
spring.security.oauth2.client.registration.google.client-name=Google

# Server Port
server.port=8080
server.servlet.context-path=/

# JWT Configuration (Sinh ngẫu nhiên chuỗi Base64 dài 256-bit)
jwt.secret=YOUR_JWT_SECRET_KEY
jwt.expiration=86400000

# File Upload Configuration
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
spring.servlet.multipart.file-size-threshold=2KB

# Static Resources
spring.web.resources.static-locations=classpath:/static/,classpath:/public/
upload.dir=./uploads

# Thymeleaf
spring.thymeleaf.cache=false
spring.thymeleaf.prefix=classpath:/templates/
spring.thymeleaf.suffix=.html

# Logging
logging.level.root=INFO
logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss} - %msg%n

# ==========================================
# VNPAY SANDBOX CONFIGURATION
# ==========================================
app.frontend-url=http://localhost:5173

# API Endpoint Sandbox của VNPay
vnpay.url=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Điền thông tin merchant sandbox của bạn (nhận từ email đăng ký VNPay)
vnpay.tmn-code=YOUR_VNPAY_TMN_CODE
vnpay.hash-secret=YOUR_VNPAY_HASH_SECRET

# Đổi domain ngrok của bạn khi chạy (để nhận callback từ VNPay)
vnpay.return-url=https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app/api/cart/payment/vnpay-return
vnpay.ipn-url=https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app/api/cart/payment/vnpay-ipn
