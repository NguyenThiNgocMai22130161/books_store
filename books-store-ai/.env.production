# ===== PRODUCTION ENVIRONMENT =====
# Copy this file to .env and fill in your values

# ===== DATABASE =====
PG_DSN=postgresql://neondb_owner:npg_N9hKEuY1iBsv@ep-holy-rain-aokglcju-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ===== BACKEND API =====
# Replace with your production backend URL
BACKEND_BASE_URL=https://your-backend.com
JWT_TOKEN=YOUR_PRODUCTION_JWT_TOKEN

# ===== GOOGLE AI =====
# IMPORTANT: Use your production API key
GOOGLE_API_KEY=YOUR_PRODUCTION_API_KEY

# ===== MODEL CONFIGURATION =====
LLM_MODEL=models/gemini-2.5-flash
EMBED_MODEL=models/gemini-embedding-001
EMBED_DIM=3072

# ===== RAG SETTINGS =====
TOP_K_RESULTS=8
SCORE_THRESHOLD=0.3
TEMPERATURE=0.3
KEYWORD_BOOST=0.2
RATING_BOOST=0.1
SALES_BOOST=0.15

# ===== ADVANCED =====
ENABLE_CACHE=true
CACHE_TTL=3600
MAX_CHAT_HISTORY=10
DEBUG=false
ENVIRONMENT=production

# ===== SECURITY =====
ALLOWED_ORIGINS=https://your-frontend.com,https://www.your-frontend.com
CORS_CREDENTIALS=true
MAX_REQUEST_SIZE=10485760

# ===== PERFORMANCE =====
WORKERS=4
MAX_CONNECTIONS=100
TIMEOUT=300
